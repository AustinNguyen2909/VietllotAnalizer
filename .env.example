# --- Local Postgres (used by migration scripts) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=vietlott_user
DB_PASSWORD=vietlott_password
DB_NAME=vietlott_db

# --- Supabase application database (Connect > Shared pooler) ---
# Either paste the full connection string (percent-encode special characters
# in the password, e.g. @ -> %40, # -> %23, / -> %2F):
# SUPABASE_DB_URL=postgresql://postgres.ewidfqyceqzpqdeebobp:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
#
# ...or set the parameters and let the script encode the password for you:
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.ewidfqyceqzpqdeebobp
SUPABASE_DB_PASSWORD=your-database-password
